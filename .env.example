# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
# Document analyzer. Auto-filing stays off until real use shows the analyzer's
# unchanged-approval rate is high enough at the threshold. Effort: low|medium|high.
ANALYZER_MODEL=claude-haiku-5-5
ANALYZER_EFFORT=medium
AUTO_FILE_THRESHOLD=0.80
AUTO_FILE_ENABLED=false
DB_PATH=./data/app.db
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
# Set to true ONLY for local HTTP development (drops the Secure flag on the
# session cookie so it works over plain http://localhost). Leave false in any
# deployed environment — production must serve over HTTPS.
INSECURE_COOKIES=false

# Optional error reporting to GlitchTip (Sentry protocol); see
# docs/observability.md. Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Browser DSN is compiled into the PWA at build time (a build arg in Docker,
# read as VITE_SENTRY_DSN by `pnpm --filter @doc-scanner/pwa build`).
SENTRY_BROWSER_DSN=
