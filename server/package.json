{
  "name": "@doc-scanner/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/vendor/tsconfig.json",
    "start": "tsx src/index.ts",
    "test": "NODE_OPTIONS=--import=tsx vitest run",
    "test:watch": "NODE_OPTIONS=--import=tsx vitest",
    "test:integration": "NODE_OPTIONS=--import=tsx vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@protontech/crypto": "2.1.1",
    "@protontech/drive-sdk": "0.20.0",
    "bcryptjs": "3.0.3",
    "hono": "4.13.2",
    "openpgp": "6.3.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
