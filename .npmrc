# Supply-chain hardening for pnpm
# - minimum-release-age: 7-day soak (10080 min) refuses installing any
#   version published in the last week — defense in depth for the
#   compromised-maintainer attack vector.
# - ignore-scripts: blocks dependency lifecycle scripts (preinstall/
#   install/postinstall). Matches existing Dockerfile's
#   `npm ci --ignore-scripts` posture and makes it the policy locally too.
# - save-exact: `pnpm add` writes exact pins (no caret).
# - engine-strict: pnpm errors if local Node disagrees with engines.node.
save-exact=true
engine-strict=true
ignore-scripts=true
minimum-release-age=10080
prefer-frozen-lockfile=true
audit-level=moderate
