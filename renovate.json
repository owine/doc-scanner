{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>owine/renovate-config",
    "github>owine/renovate-config:automerge",
    "github>owine/renovate-config:node",
    "github>owine/renovate-config:docker"
  ],
  "pre-commit": { "enabled": true },
  "packageRules": [
    {
      "description": "Never auto-update vendored Proton SRP code — manual re-vendor only",
      "matchFileNames": ["server/src/vendor/**"],
      "enabled": false
    },
    {
      "description": "Isolate @protontech/drive-sdk in its own PR — 0.x minors are breaking-eligible and must be reviewed deliberately",
      "matchPackageNames": ["@protontech/drive-sdk"],
      "groupName": "@protontech/drive-sdk"
    }
  ]
}
